# Neon Postgres (server-side only, used by /api)
DATABASE_URL=

# Class hub (one sign-in for every class app; activity log). Server-side, used by /api.
HUB_URL=https://preview.cbs-tech-strategy.com
HUB_JWT_PUBLIC_KEY=
HUB_COOKIE_NAME=cts_preview_session
HUB_APP_SLUG=beli
HUB_APP_KEY=
# Optional: only while the hub's deployment sits behind Vercel Authentication
HUB_PROTECTION_BYPASS=

# Daily sweep (Vercel Cron) that resends activity reports the hub hasn't received
CRON_SECRET=

# The same hub URL and slug for the browser (inlined by Create React App at build time)
REACT_APP_HUB_URL=https://preview.cbs-tech-strategy.com
REACT_APP_HUB_APP_SLUG=beli
